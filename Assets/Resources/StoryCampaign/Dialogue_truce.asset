    body: "\u305D\u3082\u305D\u3082\u3042\u3044\u3064\u3089\u304C\u3053\u3063\u3061\u3078\u8E0F\u307F\u8FBC\u3093\u3067\u6765\u305F\u3089\u3001\u4FFA\u305F\u3061\u306F\u3069\u3046\u3059\u308A\u3083\u3044\u3044\uFF1F"
