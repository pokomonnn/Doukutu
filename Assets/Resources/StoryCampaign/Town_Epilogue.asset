    - speakerNameOverride: 
      portraitOverride: {fileID: 0}
      message: "\u753A\u306B\u306F\u307E\u3060\u4ED5\u4E8B\u304C\u8DB3\u308A\u306A\u3044\u3002\u3051\u308C\u3069\u3001\u6551\u51FA\u3055\u308C\u305F\u4EBA\u3005\u304C\u5C11\u3057\u305A\u3064\u5E97\u3084\u5DE5\u623F\u3092\u958B\u304D\u59CB\u3081\u3066\u3044\u308B\u3002"
    - speakerNameOverride: "\u753A\u9577"
      portraitOverride: {fileID: 0}
      message: "\u2026\u2026\u306F\u3042\uFF01\uFF1F \u3042\u306E\u8CB4\u65CF\u3001\u898B\u3064\u304B\u3063\u305F\u306E\u306B\u5E30\u3063\u3066\u3053\u306A\u3044\u3060\u3068\uFF01\uFF1F"
    - speakerNameOverride: "\u753A\u9577"
