      message: "\u753A\u9577\u304B\u3089\u3001\u3042\u306A\u305F\u304C\u53E4\u57CE\u3092\u8ABF\u3079\u3066\u3044\u308B\u3068\u4F3A\u3044\u307E\u3057\u305F\u3002"
    - speakerNameOverride: "\u57F7\u4E8B"
      portraitOverride: {fileID: 0}
      message: "\u4E3B\u4EBA\u306F\u3001\u81EA\u5206\u3067\u6C7A\u3081\u305F\u3053\u3068\u306B\u8AA0\u5B9F\u306A\u65B9\u3067\u3057\u305F\u3002\u7121\u4E8B\u3067\u3044\u3066\u304F\u3060\u3055\u308C\u3070\u3088\u3044\u306E\u3067\u3059\u304C\u2026\u2026\u3002"
    - speakerNameOverride: "\u57F7\u4E8B"
      portraitOverride: {fileID: 0}
      message: "\u9060\u5F81\u306E\u8A73\u3057\u3044\u76EE\u7684\u306B\u3064\u3044\u3066\u306F\u3001\u79C1\u3082\u805E\u304B\u3055\u308C\u3066\u304A\u308A\u307E\u305B\u3093\u3002"
    - speakerNameOverride: "\u57F7\u4E8B"
      portraitOverride: {fileID: 0}
      message: "\u4F55\u304B\u65B0\u3057\u3044\u3053\u3068\u304C\u5206\u304B\u308A\u307E\u3057\u305F\u3089\u3001\u3069\u3046\u304B\u6559\u3048\u3066\u304F\u3060\u3055\u3044\u3002"
    - speakerNameOverride: "\u57F7\u4E8B"
