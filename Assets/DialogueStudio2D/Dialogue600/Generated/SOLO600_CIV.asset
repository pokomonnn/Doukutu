    text: "\u6301\u3061\u4E3B\u306F\u7121\u4E8B\u306B\u5E30\u308C\u305F\u306E\u304B\u306A\u3002"
    speakerInfo: "\u8077\u4EBA\u30FB\u5546\u4EBA\u30FB\u533B\u8005\u30FB\u6551\u51FA\u5BFE\u8C61NPC"
    sourceSituation: "\u5DE5\u623F\u533A\u30FB\u907F\u96E3"
    sourcePrerequisites: "\u6551\u51FA\u5F85\u3061\u30FB\u540C\u884C\u4E2D\u306E\u4E00\u6642\u5F85\u6A5F\u30FB\u5B89\u5168\u306A\u907F\u96E3\u5730\u70B9\u3002\u4F1A\u8A71\u4E0D\u53EF\uFF0F\u884C\u52D5\u4E0D\u80FD\u72B6\u614B\u3067\u306F\u518D\u751F\u3057\u306A\u3044\u3002"
    sourcePersonalityHint: "\u6A19\u6E96\uFF0F\u81C6\u75C5\uFF0F\u4EF2\u9593\u601D\u3044\uFF08\u5FC5\u9808\u30D5\u30A3\u30EB\u30BF\u3067\u306F\u306A\u3044\uFF09"
    sourcePlaybackHint: "\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u8074\u53D6\u7BC4\u56F2\u5185\uFF0F\u4ED6\u306E\u767A\u8A71\u3068\u6392\u4ED6\u3002\u5171\u901A\u30AF\u30FC\u30EB\u30C0\u30A6\u30F390\u301C180\u79D2\uFF08\u63D0\u6848\u5024\uFF09\u3002"
    weight: 1
