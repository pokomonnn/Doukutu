  - sourceDialogueId: SOLO_ADV_001
    title: "\u706B\u306E\u756A"
    requiredStage: 0
    text: "\u706B\u304C\u6D88\u3048\u306A\u3044\u3088\u3046\u306B\u2026\u2026\u3068\u3002\u3053\u308C\u3067\u3088\u3057\u3002"
    speakerInfo: "\u5192\u967A\u8005NPC"
    sourceSituation: "\u91CE\u55B6"
    sourcePrerequisites: "\u5DE1\u56DE\u30FB\u63A2\u7D22\u30FB\u4F11\u61A9\u30FB\u4F5C\u696D\u306A\u3069\u8A72\u5F53\u72B6\u614B\u306B\u3042\u308B\u3053\u3068\u3002\u6226\u95D8\u4E2D\u306F\u4E2D\u65AD\u3002"
    sourcePersonalityHint: "\u6A19\u6E96\uFF0F\u614E\u91CD\uFF0F\u4EF2\u9593\u601D\u3044\uFF08\u5FC5\u9808\u30D5\u30A3\u30EB\u30BF\u3067\u306F\u306A\u3044\uFF09"
