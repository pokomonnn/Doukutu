  entries:
  - sourceDialogueId: SOLO_HOST_041
    title: "\u8FD1\u3065\u304F\u7269\u97F3"
    requiredStage: 0
    text: "\u2026\u2026\u8AB0\u304B\u6765\u308B\u3002"
    speakerInfo: "\u77E5\u6027\u3042\u308B\u6575\u5BFENPC\uFF08\u8A9E\u5C3E\u306F\u6D3E\u95A5\u306B\u5408\u308F\u305B\u3066\u8ABF\u6574\uFF09"
    sourceSituation: "\u6C4E\u7528\u8B66\u6212\u30FB\u6D3E\u95A5\u3054\u3068\u306B\u8A9E\u5C3E\u8ABF\u6574"
    sourcePrerequisites: "\u8B66\u6212\u307E\u305F\u306F\u5DE1\u56DE\u4E2D\u3001\u6226\u95D8\u524D\uFF0F\u4EA4\u6226\u7D42\u4E86\u5F8C\u3002\u6226\u95D8\u4E2D\u306E\u639B\u3051\u58F0\u306F\u5225\u30AB\u30C6\u30B4\u30EA\u3067\u6271\u3044\u3001\u91CD\u8907\u518D\u751F\u3057\u306A\u3044\u3002"
    sourcePersonalityHint: "\u653B\u6483\u7684\uFF0F\u614E\u91CD\uFF0F\u81C6\u75C5\uFF08\u767A\u8A00\u306B\u5408\u308F\u305B\u9078\u629E\uFF09\uFF08\u5FC5\u9808\u30D5\u30A3\u30EB\u30BF\u3067\u306F\u306A\u3044\uFF09"
    sourcePlaybackHint: "\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u8074\u53D6\u7BC4\u56F2\u5185\uFF0F\u4ED6\u306E\u767A\u8A71\u3068\u6392\u4ED6\u3002\u5171\u901A\u30AF\u30FC\u30EB\u30C0\u30A6\u30F390\u301C180\u79D2\uFF08\u63D0\u6848\u5024\uFF09\u3002"
    weight: 1
