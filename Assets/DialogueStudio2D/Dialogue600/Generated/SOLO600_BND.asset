  entries:
  - sourceDialogueId: SOLO_BND_001
    title: "\u934B\u5E95"
    requiredStage: 0
    text: "\u934B\u306E\u5E95\u306B\u3001\u3042\u3068\u4E00\u53E3\u304F\u3089\u3044\u6B8B\u3063\u3066\u306A\u3044\u304B\u306A\u3002"
    speakerInfo: "\u76D7\u8CCANPC"
    sourceSituation: "\u91CE\u55B6"
    sourcePrerequisites: "\u5DE1\u56DE\u30FB\u63A2\u7D22\u30FB\u4F11\u61A9\u30FB\u4F5C\u696D\u306A\u3069\u8A72\u5F53\u72B6\u614B\u306B\u3042\u308B\u3053\u3068\u3002\u6226\u95D8\u4E2D\u306F\u4E2D\u65AD\u3002"
    sourcePersonalityHint: "\u6A19\u6E96\uFF0F\u614E\u91CD\uFF0F\u653B\u6483\u7684\uFF08\u5FC5\u9808\u30D5\u30A3\u30EB\u30BF\u3067\u306F\u306A\u3044\uFF09"
    sourcePlaybackHint: "\u30D7\u30EC\u30A4\u30E4\u30FC\u306E\u8074\u53D6\u7BC4\u56F2\u5185\uFF0F\u4ED6\u306E\u767A\u8A71\u3068\u6392\u4ED6\u3002\u5171\u901A\u30AF\u30FC\u30EB\u30C0\u30A6\u30F390\u301C180\u79D2\uFF08\u63D0\u6848\u5024\uFF09\u3002"
    weight: 1
  - sourceDialogueId: SOLO_BND_002
    title: "\u53E4\u3044\u9152"
